{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/commander",
      "destination": "/commander.html"
    },
    {
      "source": "/commande-confirmee",
      "destination": "/commande-confirmee.html"
    },
    {
      "source": "/offrir",
      "destination": "/offrir.html"
    },
    {
      "source": "/prestations",
      "destination": "/prestations.html"
    },
    {
      "source": "/avis",
      "destination": "/avis.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
